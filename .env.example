# ── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# Mesmos valores da instância do AletheIA na VPS.
# O valor depende de ONDE o backend roda, porque o compose usa rede bridge:
#
#   - Desenvolvimento local (Docker na sua máquina):
#       http://216.22.5.199:8080
#     A Evolution está na VPS, então o backend local sai pela internet.
#
#   - Produção, backend e Evolution na MESMA VPS:
#       http://host.docker.internal:8080
#     NÃO use 127.0.0.1 aqui. De dentro do container, 127.0.0.1 é o próprio
#     container, não a host — a Evolution responde "Connection refused" na
#     hora de criar a conexão do WhatsApp. O compose expõe a host como
#     host.docker.internal via `extra_hosts: host-gateway`.
EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=cole-aqui-sua-chave

# 1 = nenhuma chamada HTTP sai do processo (demo/dev sem queimar número real).
MODO_SIMULACAO=1

# Base pública do backend, usada para registrar o webhook da Evolution.
# Precisa ser alcançável pela Evolution API. Sem isso o SIM/ADIAR nunca chega.
WEBHOOK_PUBLIC_URL=https://aletheia.ia.br/lembrazap

# ── Banco e fila ─────────────────────────────────────────────────────────────
# Injetados pelo docker-compose. Só defina à mão para rodar fora do Docker.
DATABASE_URL=postgresql+psycopg2://lembrazap_user:password_segura@db:5432/lembrazap
REDIS_URL=redis://redis:6379/0

# ── Fuso horário ─────────────────────────────────────────────────────────────
TIMEZONE=America/Manaus

# ── Stripe (assinatura recorrente por cartão) ─────────────────────────────────
# Tudo aqui é OPCIONAL. Sem estas variáveis o sistema funciona por cobrança
# manual: o painel do proprietário marca a conta como ativa, suspensa ou
# inadimplente, e nada mais muda. Nenhum código quebra com elas vazias.
#
# Onde pegar cada uma:
#   STRIPE_SECRET_KEY      Stripe > Desenvolvedores > Chaves da API > Secret key
#                          (prefixo `sk_test_` em teste, `sk_live_` em produção)
#   STRIPE_WEBHOOK_SECRET  Stripe > Desenvolvedores > Webhooks > ao criar o
#                          endpoint, o "Segredo de assinatura" aparece no fim da
#                          URL de comando. É o que prova que a requisição é do
#                          Stripe e não de alguém fingindo ser.
#   STRIPE_PRICE_ID_*      Stripe > Produtos > cada preço recorrente. Copie o
#                          "price_..." de Starter, Pro e Business.
#
# Eventos que o endpoint /api/admin/stripe/webhook escuta:
#   checkout.session.completed, invoice.paid, invoice.payment_failed,
#   customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# Preços em centavos. Vazio = usa o catálogo de app/config/planos.py.
# Definir aqui sobrescreve o arquivo, o que permite mudar preço sem redeploy
# do código (basta reiniciar o container).
STRIPE_PRECIO_STARTER=4900
STRIPE_PRECIO_PRO=9900
STRIPE_PRECIO_BUSINESS=19900

# URL usada nos botões "assinar" e "gerenciar assinatura" que o Stripe devolve.
# Sem barra final.
FRONTEND_URL=https://lembrazap.aletheia.ia.br


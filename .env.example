# ── Evolution API (mesmos valores usados pelo AletheIA no docker-compose dele) ──
# Deixe EVOLUTION_API_URL vazio para rodar em MODO_SIMULACAO (nenhum envio real).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# 1 = não chama a Evolution API de jeito nenhum (desenvolvimento/demo)
MODO_SIMULACAO=0

# ── IA do agendamento automático (opcionais) ──────────────────────────────────
# Sem estas chaves o agendamento por IA usa o parser local (regex).
# Groq é o primário (barato); Gemini entra só como fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
# IA_MODELO_GROQ=llama-3.1-8b-instant
# IA_MODELO_GEMINI=gemini-2.5-flash

# URL pública que a Evolution API consegue chamar de volta para o opt-out ("SAIR").
# Ex.: https://aletheia.ia.br/lembrazap
WEBHOOK_PUBLIC_URL=

# Onde os JSON ficam (dentro do container use /app/dados, que é um volume)
DADOS_DIR=/app/dados
PORTA=8050

# ── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# Mesmos valores da instância do AletheIA na VPS.
EVOLUTION_API_URL=http://216.22.5.199:8080
EVOLUTION_API_KEY=cole-aqui-sua-chave

# 1 = nenhuma chamada HTTP sai do processo (demo/dev sem queimar número real).
MODO_SIMULACAO=1

# Base pública do backend, usada para registrar o webhook da Evolution.
# Precisa ser alcançável pela Evolution API. Sem isso o SIM/ADIAR nunca chega.
WEBHOOK_PUBLIC_URL=https://aletheia.ia.br/lembrazap

# ── Banco e fila ─────────────────────────────────────────────────────────────
# Injetados pelo docker-compose. Só defina à mão para rodar fora do Docker.
DATABASE_URL=postgresql+psycopg2://lembrazap_user:password_segura@db:5432/lembrazap
REDIS_URL=redis://redis:6379/0

# ── Fuso horário ─────────────────────────────────────────────────────────────
TIMEZONE=America/Manaus